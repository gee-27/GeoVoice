{
 "name": "geovoice",
 "version": "2.1.0",
 "private": true,
 "type": "module",
 "engines": {
  "node": "24.x"
 },
 "scripts": {
  "start": "node server.mjs",
  "setup": "node scripts/setup.mjs",
  "db:migrate": "node scripts/migrate.mjs",
  "db:cleanup": "node scripts/cleanup.mjs",
  "test": "node --test --test-concurrency=1 tests/*.test.mjs",
  "check": "node scripts/check.mjs",
  "build": "node scripts/check.mjs",
  "deploy:prepare": "npm run check && npm run db:migrate"
 },
 "dependencies": {
  "pg": "8.23.0",
  "qrcode": "^1.5.4"
 },
 "devDependencies": {
  "@electric-sql/pglite": "0.5.8",
  "linkedom": "0.18.13"
 }
}
